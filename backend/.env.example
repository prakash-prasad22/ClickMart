# ───────── Server ─────────
NODE_ENV=development
PORT=5000
# URL of the Next.js storefront (used for CORS)
CLIENT_URL=http://localhost:3000

# ───────── Database ─────────
# Replace with your MongoDB Atlas / self-hosted connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/clickmart?retryWrites=true&w=majority

# ───────── Auth ─────────
# Use a long random string in production (e.g. `openssl rand -hex 48`)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
COOKIE_NAME=cm_token

# ───────── OTP / SMS ─────────
OTP_TTL_MINUTES=5
OTP_LENGTH=6
# console | msg91 | twilio   (console just prints the OTP in the server log)
SMS_PROVIDER=console
SMS_API_KEY=<your-sms-api-key>
SMS_SENDER_ID=<your-sender-id>
SMS_TEMPLATE_ID=<your-dlt-template-id>
TWILIO_ACCOUNT_SID=<twilio-account-sid>
TWILIO_AUTH_TOKEN=<twilio-auth-token>
TWILIO_FROM_NUMBER=<twilio-from-number>
# Default country code applied to 10-digit numbers
DEFAULT_COUNTRY_CODE=+91

# ───────── Payments (placeholder, not wired yet) ─────────
RAZORPAY_KEY_ID=<razorpay-key-id>
RAZORPAY_KEY_SECRET=<razorpay-key-secret>

# ───────── Seed admin (used by `npm run seed`) ─────────
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@clickmart.local
SEED_ADMIN_PASSWORD=ChangeMe@123
