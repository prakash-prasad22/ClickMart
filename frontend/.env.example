# URL of the Express API (server-side only; the browser goes through /api rewrites)
BACKEND_URL=http://localhost:5000

# Must match COOKIE_NAME in backend/.env
AUTH_COOKIE_NAME=cm_token

# Public site URL (used for metadata / canonical links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Maps JavaScript API key — enable "Maps JavaScript API" and "Geocoding API".
# Restrict it to your domain(s) in Google Cloud Console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=<your-google-maps-api-key>
